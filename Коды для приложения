<Window x:Class="TourFirmApp.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="340" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="30" VerticalAlignment="Center">
        <TextBlock Text="Туристическая фирма" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="LoginTextBox" Height="28" Margin="0,4,0,12"
                 VerticalContentAlignment="Center"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordInput" Height="28" Margin="0,4,0,20"
                     VerticalContentAlignment="Center"/>
        <Button Content="Войти" Height="34" IsDefault="True"
                Click="LoginButton_Click"/>
    </StackPanel>
</Window>

using System;
using System.Linq;
using System.Windows;
using Microsoft.EntityFrameworkCore;
using TourFirmApp.DataBase;

namespace TourFirmApp
{
    public partial class AuthWindow : Window
    {
        public AuthWindow()
        {
            InitializeComponent();
        }

        private void LoginButton_Click(object sender, RoutedEventArgs e)
        {
            string login = LoginTextBox.Text.Trim();
            string password = PasswordInput.Password;

            if (login == "" || password == "")
            {
                MessageBox.Show("Введите логин и пароль.", "Авторизация",
                    MessageBoxButton.OK, MessageBoxImage.Warning);
                return;
            }

            try
            {
                using var db = new DBContext();

                var user = db.Users
                    .Include(u => u.Role)
                    .Include(u => u.Auth)
                    .FirstOrDefault(u => u.Auth.Login == login
                                      && u.Auth.Password == password);

                if (user == null)
                {
                    MessageBox.Show("Неверный логин или пароль.", "Авторизация",
                        MessageBoxButton.OK, MessageBoxImage.Error);
                    return;
                }

                MainWindow main = new MainWindow(user);
                main.Show();
                Close();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Не удалось подключиться к базе данных:\n" + ex.Message,
                    "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }
    }
}

<Window x:Class="TourFirmApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информационная система туристической фирмы"
        Height="360" Width="640" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="30">
        <TextBlock x:Name="WelcomeText" FontSize="22" FontWeight="Bold"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="RoleText" FontSize="16" Margin="0,10,0,0"/>
        <Button Content="Выйти" Width="120" Height="32"
                HorizontalAlignment="Left" Margin="0,30,0,0"
                Click="LogoutButton_Click"/>
    </StackPanel>
</Window>

using System.Windows;
using TourFirmApp.DataBase;

namespace TourFirmApp
{
    public partial class MainWindow : Window
    {
        public MainWindow(User user)
        {
            InitializeComponent();

            WelcomeText.Text = $"Добро пожаловать, {user.FirstName} {user.MiddleName}!";
            RoleText.Text = $"Ваша роль: {user.Role.Name}";
        }

        private void LogoutButton_Click(object sender, RoutedEventArgs e)
        {
            AuthWindow auth = new AuthWindow();
            auth.Show();
            Close();
        }
    }
}

set search_path to public;

SELECT r.client_id,
       COUNT(r.request_id),
       SUM(t.price * r.quantity),
       ROUND(SUM((t.price + COALESCE(s.price, 0)) * r.quantity
           * (1 - COALESCE(d.percentage, 0) / 100)), 2)
FROM request r
JOIN tour t ON r.tour_id = t.tour_id
LEFT JOIN services s ON t.service_id = s.service_id
LEFT JOIN discount d ON r.discount_id = d.discount_id
GROUP BY r.client_id
ORDER BY r.client_id;
